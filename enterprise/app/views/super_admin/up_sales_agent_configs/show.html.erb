<% content_for(:title) { "Up Sales — Agentes — #{@account.name}" } %>

<header class="main-content__header" role="banner">
  <h1 class="main-content__page-title" id="page-title">
    <%= content_for(:title) %>
  </h1>
</header>

<section class="main-content__body">
  <p class="mb-4">
    <%= link_to '← Todas as contas', super_admin_up_sales_agent_configs_path %>
  </p>

  <%= form_with url: super_admin_account_up_sales_agent_config_path(@account), method: :patch, local: true do |form| %>
    <fieldset class="mb-8">
      <legend class="font-bold mb-2">Conexão com o up2-agents</legend>

      <%= fields_for :agent_tenant, @agent_tenant do |tenant_form| %>
        <div class="flex mb-4">
          <div class="field-unit__label">
            <%= tenant_form.label :agents_tenant_id, 'Tenant ID' %>
          </div>
          <div class="-mt-2 field-unit__field">
            <%= tenant_form.text_field :agents_tenant_id, class: "mt-2 border border-slate-100 p-1.5 rounded-md w-full" %>
          </div>
        </div>
        <div class="flex mb-4">
          <div class="field-unit__label">
            <%= tenant_form.label :agents_tenant_slug, 'Tenant slug (opcional, só exibição)' %>
          </div>
          <div class="-mt-2 field-unit__field">
            <%= tenant_form.text_field :agents_tenant_slug, class: "mt-2 border border-slate-100 p-1.5 rounded-md w-full" %>
          </div>
        </div>
        <div class="flex mb-4">
          <div class="field-unit__label">
            <%= tenant_form.label :api_key, 'API key (secv4_...)' %>
          </div>
          <div class="-mt-2 field-unit__field">
            <%= tenant_form.password_field :api_key,
                value: '',
                placeholder: @agent_tenant.persisted? ? 'Preenchida — só digite aqui para trocar' : '',
                class: "mt-2 border border-slate-100 p-1.5 rounded-md w-full"
            %>
            <p class="pt-2 text-xs italic text-slate-400">
              Criada manualmente no painel up2-agents, logado como admin daquele tenant (não existe
              chave de plataforma entre tenants). Deixe em branco pra manter a atual.
            </p>
          </div>
        </div>
        <div class="flex mb-4">
          <div class="field-unit__label">
            <%= tenant_form.label :calendar_integration_instance_id, 'Calendar integration instance ID' %>
          </div>
          <div class="-mt-2 field-unit__field">
            <%= tenant_form.text_field :calendar_integration_instance_id, class: "mt-2 border border-slate-100 p-1.5 rounded-md w-full" %>
            <p class="pt-2 text-xs italic text-slate-400">
              O id da integração GOOGLE_CALENDAR desse tenant no painel up2-agents (aba
              Integrações → Calendar). Necessário pro botão "Agendar" na tela de Conversas.
            </p>
          </div>
        </div>
        <div class="flex mb-4">
          <div class="field-unit__label">
            <%= tenant_form.label :whatsapp_inbox_id, 'Inbox WhatsApp (dispatcher)' %>
          </div>
          <div class="-mt-2 field-unit__field">
            <%= tenant_form.select :whatsapp_inbox_id,
                options_from_collection_for_select(@whatsapp_inboxes, :id, :name, @agent_tenant.whatsapp_inbox_id),
                { include_blank: '— nenhuma —' },
                { class: "mt-2 border border-slate-100 p-1.5 rounded-md w-full" }
            %>
            <p class="pt-2 text-xs italic text-slate-400">
              Fase 6 (dispatcher): de qual inbox WhatsApp desta conta a Lavínia origina o primeiro
              contato. Só lista inboxes do canal WhatsApp já conectados nesta conta.
            </p>
          </div>
        </div>
      <% end %>
    </fieldset>

    <% if @agent_tenant.persisted? %>
      <p class="mb-4 text-sm">
        Dispatcher (Fase 6):
        <% if @agent_tenant.dispatcher_ready? %>
          <span class="text-green-600 font-bold">pronto</span> — inbox WhatsApp e agente de
          prospecção (slot SDR) configurados.
        <% else %>
          <span class="text-amber-600 font-bold">incompleto</span> — falta
          <%= @agent_tenant.whatsapp_inbox_id.present? ? '' : 'a inbox WhatsApp' %>
          <%= @agent_tenant.whatsapp_inbox_id.present? || @agent_tenant.prospecting_agent_up2_id.present? ? '' : ' e ' %>
          <%= @agent_tenant.prospecting_agent_up2_id.present? ? '' : 'o slot SDR ativado abaixo' %>.
        <% end %>
      </p>
    <% end %>

    <fieldset class="mb-8">
      <legend class="font-bold mb-2">Agentes ativos (seleção múltipla)</legend>
      <% UpSales::AgentSlot::AGENT_TYPES.each do |type| %>
        <div class="flex items-center mb-2">
          <label class="flex items-center gap-2">
            <input type="checkbox" name="enabled[<%= type %>]" value="1" <%= 'checked' if @slots[type].enabled? %> />
            <%= UpSales::AgentSlot::LABELS.fetch(type) %>
          </label>
          <% if @slots[type].up2_agents_agent_id.present? %>
            <span class="text-xs text-slate-400 ml-2">(agent id: <%= @slots[type].up2_agents_agent_id %>)</span>
          <% end %>
        </div>
      <% end %>
    </fieldset>

    <div class="form-actions">
      <%= form.submit 'Salvar' %>
    </div>
  <% end %>
</section>
